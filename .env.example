# ========================================================
# TEMPLATE DE CONFIGURAÇÃO DE AMBIENTE - VERMONT MINERAÇÃO
# Copie este arquivo para .env.local e preencha com suas credenciais reais
# ========================================================

# Supabase (Banco de Dados e Autenticação)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-do-supabase

# E-mail Corporativo de Notificação da Logística
VITE_EMAIL_NOTIFICACAO_DESTINO=teste@seuemail.com.br

# Senha de Acesso Administrativo e Operacional (Fallback quando sem Supabase Auth)
VITE_ADMIN_PASSWORD=sua-senha-admin-aqui
VITE_OPERADOR_PASSWORD=sua-senha-operador-aqui
