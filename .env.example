# Supabase (Chaves e URLs da API)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-do-supabase

# E-mail de destino padrão para cópia de agendamentos (opcional)
VITE_EMAIL_NOTIFICACAO_DESTINO=seu-email-notificacao@empresa.com.br
